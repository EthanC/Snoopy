{
  "private": true,
  "name": "snoopy-app",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run test:types && npm run lint && npm run test:unit && npm run build",
    "deploy": "npm run check && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "oxlint --type-aware src",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "protobufjs": "8.8.1"
  },
  "dependencies": {
    "@devvit/web": "0.14.8",
    "@hono/node-server": "^2.1.5",
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@devvit/shared-types": "0.14.8",
    "@devvit/start": "0.14.8",
    "@types/node": "^26.6.5",
    "devvit": "0.14.8",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
