{
  "private": true,
  "name": "snoopy-app",
  "version": "1.0.0",
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "check": "npm run test:types && npm run lint && npm run test:unit && npm run build",
    "deploy": "npm run check && devvit upload",
    "dev": "devvit playtest",
    "launch": "npm run deploy && devvit publish",
    "lint": "eslint src",
    "login": "devvit login",
    "prettier": "prettier --write .",
    "test:types": "tsc --build",
    "test:unit": "node --experimental-strip-types --no-warnings=ExperimentalWarning --test \"src/**/*.test.ts\""
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "protobufjs": "7.6.5"
  },
  "dependencies": {
    "@devvit/web": "0.14.4",
    "@hono/node-server": "^2.1.1",
    "hono": "4.13.8"
  },
  "devDependencies": {
    "@devvit/shared-types": "0.14.4",
    "@devvit/start": "0.14.4",
    "@eslint/js": "10.0.1",
    "@types/node": "^26.5.1",
    "devvit": "0.14.4",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0"
  }
}
